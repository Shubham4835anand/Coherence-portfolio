{
    "buildCommand": "npm run build",
    "outputDirectory": "client/dist",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://coherence-portfolio-a6qn.vercel.app/api/$1"
        },
        {
            "source": "/src/assets/photo/(.*)",
            "destination": "/photo/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
